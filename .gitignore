app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# --- Project additions -------------------------------------------------------
# Secrets and signing (never commit)
.env
env.json
*.env
key.properties
*.jks
*.keystore

# Android build outputs (never built locally, but just in case)
/android/.gradle/
/android/app/build/
/android/build/
/android/local.properties

# Web build output
/build/web/

# ML: keep exported .tflite files in assets/models/, ignore training leftovers
/ml/data/
/ml/checkpoints/
/ml/**/*.ckpt
/ml/**/*.pt
/ml/**/*.safetensors
/ml/**/.ipynb_checkpoints/

